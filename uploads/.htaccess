# Never execute scripts from the uploads directory
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|asp|aspx|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Serve images only
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
Options -ExecCGI -Indexes
AddType text/plain .php .phtml .phar
